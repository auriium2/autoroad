6-4#,#6-4 Major#,#Artificial Intelligence and Decision Making#,#Bachelor of Science in Artificial Intelligence and Decision Making

The Bachelor of Science in Artificial Intelligence and Decision Making aims to integrate disciplines typically taught in different departments including electrical engineering, computer science, statistics, operations research, and brain and cognitive sciences.

fundamentals
centers
ci_m
social_ethics
electives

fundamentals, "Fundamentals" := (6.100A/6.100L), 6.1200, (6.S084/18.C06/18.06), (6.3700/6.3800/18.05), 6.1010, 6.1210

centers, "Centers (select 5 from 5 categories)" := data_centric, model_centric, decision_centric, computation_centric, human_centric{>=5}

data_centric, "Data Centric" := (6.3720/6.3900/(6.C01, 6.S052)/(6.C51, 6.S952)/6.S059){>=1}

model_centric, "Model Centric" := (6.3000/6.4110/6.4400){>=1}

decision_centric, "Decision Centric" := (6.3100/6.4110/6.7201){>=1}

computation_centric, "Computation Centric" := (6.1220/6.4400/6.7201){>=1}

human_centric, "Human Centric" := (6.3260/6.3950/6.4120/6.4590/6.C35/6.S041/9.660){>=1}

ci_m, "Communication-Intensive (select 2)" := 6.1800/6.2040/6.2060/6.2061/6.2220/6.2221/6.2370/6.2600/6.4200/6.4210/6.4590/6.4860/6.4880/6.8301/6.8611/6.9030/6.UAR/6.UAT{>=2}

social_ethics, "Social and Ethical Responsibilities of Computing" := 6.3900/6.3950/6.4590/6.8301/6.8611

electives, "Electives" := app_cim, elective_choice

%% Mandatory Application CI-M course plus either another Application CI-M or an AI+D_AUS
app_cim, "Application CI-M and AI+D_AUS" := mandatory_app_cim, additional_app_or_aus

%% Choose either a course from the large approved list or a math (Course 18) course
elective_choice, "Additional elective (Course or Math 18)" := major_elective_courses/math_requirement{>=1}

mandatory_app_cim, "Mandatory Application CI-M" := 6.4200/6.4210/6.8301/6.8611

additional_app_or_aus, "Additional Application CI-M or AI+D_AUS (select 2)" := aus_options/app_cim_options{>=2|>=1}

aus_options, "AI+D_AUS" := 18.404/6.3730/6.4210/6.5151/6.5831/6.7411/6.7930/6.8300/6.8301/6.8371/6.8611/6.8701/6.8711/6.S079/6.S966

app_cim_options, "Application CI-M" := 6.4200/6.4210/6.8301/6.8611

