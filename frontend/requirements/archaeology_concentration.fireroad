Archaeology#,#Archaeology#,#HASS Concentration in Archaeology and Archaeological Science#,#Concentration in Archaeology

A concentration in Archaeology and Archaeological Science requires four courses including two required core courses and two additional archaeology-related HASS electives.

required_core, "Required Core Courses" := 3.986, 3.985J
%% 3.986 = The Human Past: Introduction to Archaeology
%% 3.985J = Archaeological Science

archaeology_materials, "Archaeology & Materials Courses" := 3.094, 3.982, 3.983, 3.987, 3.993
%% 3.094 = Materials in Human Experience
%% 3.982 = The Ancient Andean World
%% 3.983 = Ancient Mesoamerican Civilization
%% 3.987 = Human Evolution: Data from Palaeontology, Archaeology, and Materials Science
%% 3.993 = Archaeology of the Middle East

ancient_history, "Ancient History Courses" := 21H.130, 21H.132, 21H.133, 21H.236, 21H.237, 21H.239, 21H.331
%% 21H.130 = The Ancient World: Greece
%% 21H.132 = The Ancient World: Rome
%% 21H.133 = The Medieval World
%% 21H.236 = The Making of a Roman Emperor
%% 21H.237 = The City of Athens in the Age of Pericles
%% 21H.239 = The City of Rome in the Age of the Caesars
%% 21H.331 = Julius Caesar and the Fall of the Roman Republic

ancient_literature, "Ancient Literature & Culture" := 21L.001, 21L.014, 21L.016, 21L.455
%% 21L.001 = Foundations of Western Literature: Homer to Dante
%% 21L.014 = Introduction to Ancient and Medieval Studies
%% 21L.016 = Gods and Mortals
%% 21L.455 = Ancient Authors

archaeology_electives, "Archaeology Electives" := archaeology_materials / ancient_history / ancient_literature

two_electives, "Two Additional Archaeology Subjects" := (archaeology_electives){>=2}

total, "Total Requirements" := required_core, two_electives

